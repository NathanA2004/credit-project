generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards CreditCard[]
}

model CreditCard {
  id                  String  @id @default(cuid())
  userId              String
  institutionName     String
  cardName            String
  lastFourDigits      String
  creditLimit         Decimal @db.Decimal(12, 2)
  currentBalance      Decimal @db.Decimal(12, 2)
  apr                 Decimal @db.Decimal(5, 2)
  statementClosingDay Int
  paymentDueDay       Int
  gracePeriodDays     Int
  cashbackCategory    Json
  plaidAccountId      String? @unique

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  paymentAlerts  PaymentAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id              String   @id @default(cuid())
  cardId          String
  amount          Decimal  @db.Decimal(12, 2)
  category        String
  merchant        String
  transactionDate DateTime
  isPaid          Boolean  @default(false)

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([transactionDate])
}

enum AlertStatus {
  UPCOMING
  URGENT
  OVERDUE
  SETTLED
}

model PaymentAlert {
  id        String      @id @default(cuid())
  cardId    String
  dueDate   DateTime
  amountDue Decimal     @db.Decimal(12, 2)
  isPaid    Boolean     @default(false)
  status    AlertStatus @default(UPCOMING)

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([dueDate])
  @@index([status])
}
